<script>
	// Pick the provider's tab on the setup page before going there. Starlight's synced tabs
	// read the choice back from this key when the page loads.
	document.querySelectorAll<HTMLAnchorElement>('a[data-provider-tab]').forEach((link) => {
		link.addEventListener('click', () => {
			try {
				localStorage.setItem('starlight-synced-tabs__provider', link.dataset.providerTab ?? '');
			} catch {
				// Storage can be blocked; the page then opens on its first tab.
			}
		});
	});
</script>

