---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image } from 'astro:assets';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import claudeAnswer from '../assets/screens/claude-answer.png';
import sfCases from '../assets/screens/sf-cases.png';
import lumenCases from '../assets/screens/lumen-cases.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/${path}/`;
const repo = 'https://github.com/badrisnarayanan/ApexAgent';

const steps = [
	['Deploy', 'From a terminal or VS Code, into an org where you are an admin.'],
	['Run setup', 'One script creates the starter agent, Lumen, the MCP server and the ten tools.'],
	['Connect', 'Add Claude or ChatGPT as an MCP client, or add a model provider key for the agent.'],
];

// The Model Context Protocol's own mark, and Lucide's bot for the agent.
const mcpIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M13.85 0a4.16 4.16 0 0 0-2.95 1.217L1.456 10.66a.835.835 0 0 0 0 1.18.835.835 0 0 0 1.18 0l9.442-9.442a2.49 2.49 0 0 1 3.541 0 2.49 2.49 0 0 1 0 3.541L8.59 12.97l-.1.1a.835.835 0 0 0 0 1.18.835.835 0 0 0 1.18 0l.1-.098 7.03-7.034a2.49 2.49 0 0 1 3.542 0l.049.05a2.49 2.49 0 0 1 0 3.54l-8.54 8.54a1.96 1.96 0 0 0 0 2.755l1.753 1.753a.835.835 0 0 0 1.18 0 .835.835 0 0 0 0-1.18l-1.753-1.753a.266.266 0 0 1 0-.394l8.54-8.54a4.185 4.185 0 0 0 0-5.9l-.05-.05a4.16 4.16 0 0 0-2.95-1.218c-.2 0-.401.02-.6.048a4.17 4.17 0 0 0-1.17-3.552A4.16 4.16 0 0 0 13.85 0m0 3.333a.84.84 0 0 0-.59.245L6.275 10.56a4.186 4.186 0 0 0 0 5.902 4.186 4.186 0 0 0 5.902 0L19.16 9.48a.835.835 0 0 0 0-1.18.835.835 0 0 0-1.18 0l-6.985 6.984a2.49 2.49 0 0 1-3.54 0 2.49 2.49 0 0 1 0-3.54l6.983-6.985a.835.835 0 0 0 0-1.18.84.84 0 0 0-.59-.245"/></svg>`;
const agentIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>`;

const parts = [
	{
		name: 'MCP server',
		icon: mcpIcon,
		what: 'Lets AI apps like Claude and ChatGPT read and update your Salesforce data. MCP is the open standard they use to call tools hosted elsewhere, here your org.',
		facts: [
			['Users sign in with', 'Their own Salesforce login, from the client.'],
		],
		link: { text: 'Set up the MCP server', href: docs('mcp/setup') },
	},
	{
		name: 'Agent',
		icon: agentIcon,
		what: 'A chat assistant inside Salesforce, in the utility bar. The starter agent is called Lumen, and you can reshape it or add your own.',
		facts: [
			['Users sign in with', 'Nothing extra. They are already in Salesforce.'],
		],
		link: { text: 'Set up the agent', href: docs('agent/setup') },
	},
];

const why = [
	{
		name: 'MCP server',
		icon: 'mcp',
		points: [
			[
				'No Flex Credits',
				'Salesforce’s own MCP servers are for Flex Credit customers. This one uses your org’s ordinary API requests.',
			],
			['Costs nothing to run', 'The model belongs to the app each person already uses, such as Claude or ChatGPT.'],
			['You choose the tools', 'Each server exposes only the tools you give it, including ones you write.'],
		],
		cost: {
			title: 'Cost to run',
			bars: [
				{ label: 'Salesforce MCP', width: 100, value: 'Flex Credits', unknown: true },
				{ label: 'ApexAgent', width: 0, value: '$0' },
			],
			note: 'Salesforce has not yet published its rate for hosted MCP usage.',
		},
	link: { text: 'Compare with Salesforce Hosted MCP Servers', href: docs('start/compare/mcp') },
	},
	{
		name: 'Agent',
		icon: 'agent',
		points: [
			['No Agentforce license', 'Agentforce is billed by usage. This agent runs on Apex you deploy.'],
			[
				'You pay the model’s price',
				'You pay your AI provider for what you use. Nothing is added per action.',
			],
			['Works with your provider', 'Use the AI provider your company already has, under the data retention agreement already in place.'],
		],
		cost: {
			title: 'Cost of one question',
			bars: [
				{ label: 'Agentforce', width: 100, value: '$0.17' },
				{ label: 'ApexAgent', width: 5.6, value: '$0.009' },
			],
			note: 'About 18× less on a low-cost model. ApexAgent: the average of 139 logged questions on Gemini Flash. Agentforce: 20 Flex Credits an action.',
		},
		link: { text: 'Compare with Agentforce', href: docs('start/compare/agent') },
	},
];

const security = [
	[
		'Who sees what',
		'Every tool that touches records runs as the signed-in user. Sharing rules, object permissions and field-level security all apply.',
	],
	[
		'The audit trail',
		'Every tool call and agent conversation is saved in your own org. Users see their own, admins see all. ApexAgent stores nothing anywhere else.',
	],
	[
		'Where data goes',
		'Only to the AI provider you choose. Whether they keep it is set by your agreement with them, such as the zero data retention terms most enterprises already have.',
	],
	['What an AI can do', 'Only what you allow. You pick the tools each agent and MCP server may use.'],
];

const config = [
	[
		'Tools',
		'Ten included, for finding, reading and saving records. Add your own with one Apex class.',
	],
	[
		'Agents',
		'As many as you need, each with its own name, look, instructions and model.',
	],
	['MCP servers', 'More than one, each with its own set of tools. Keep one read-only, for example.'],
];

---

<StarlightPage
	frontmatter={{
		title: 'An AI agent and an MCP server for Salesforce',
		description:
			'An AI agent and an MCP server for Salesforce, built in plain Apex. No Agentforce license. No Flex Credits.',
		template: 'splash',
		// The browser tab leads with the name, so it survives when the tab is narrow.
		head: [
			{ tag: 'title', content: 'ApexAgent: an AI agent and an MCP server for Salesforce' },
			{
				tag: 'meta',
				attrs: {
					property: 'og:title',
					content: 'ApexAgent: an AI agent and an MCP server for Salesforce',
				},
			},
		],
		tableOfContents: false,
		pagefind: false,
	}}
>
	<div class="aa not-content">
		<section class="hero">
			<h1 id="_top">
				<span>An AI&nbsp;agent and an MCP&nbsp;server for&nbsp;Salesforce.</span>{' '}
				<span class="hero-cost">
					<span>No Agentforce license.</span>{' '}
					<span>No Flex Credits.</span>
				</span>
			</h1>
			<p class="lede">
				Let Claude or ChatGPT work with your Salesforce data, and give your users a chat assistant
				inside Salesforce. Open source, built in plain Apex.
			</p>
			<div class="actions">
				<a class="btn btn-solid" href={docs('start/install')}>Install ApexAgent</a>
				<a class="btn btn-line" href={docs('start/overview')}>Read the docs</a>
				<a class="gh-link" href={repo}><svg class="gh" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.200 1.900 1.200 1 1.800 2.800 1.300 3.500 1 0-.8.4-1.300.7-1.600-2.700-.3-5.500-1.300-5.500-6 0-1.200.5-2.300 1.300-3.100-.200-.400-.600-1.600 0-3.200 0 0 1-.300 3.400 1.200a11.500 11.500 0 0 1 6 0c2.300-1.500 3.300-1.200 3.300-1.200.700 1.600.200 2.800.100 3.200.800.800 1.300 1.900 1.300 3.100 0 4.700-2.800 5.700-5.500 6 .500.400.900 1.100.900 2.200v3.300c0 .300.100.700.800.600A12 12 0 0 0 12 .3"/></svg>View on GitHub</a>
			</div>
		</section>

		<figure class="hero-shot">
			<div class="hero-stage">
				<div class="hero-win">
					<div class="hero-win-bar">Claude</div>
					<Image
						src={claudeAnswer}
						alt="Claude answering “What open cases does Northwind Traders have in Salesforce?” with a table of four cases, after searching and querying Salesforce through ApexAgent."
						widths={[640, claudeAnswer.width]}
						sizes="(min-width: 50rem) 32rem, 92vw"
						loading="eager"
					/>
				</div>
				<div class="hero-link" aria-hidden="true">
					<svg viewBox="20 56 472 400">
						<polygon points="20,456 228,56 284,56 316,117.54 140,456"></polygon>
						<polygon points="336,156 492,456 268.98,456 357.38,352 280.88,262"></polygon>
					</svg>
				</div>
				<div class="hero-win">
					<div class="hero-win-bar">Salesforce</div>
					<Image
						src={sfCases}
						alt="The Cases list for the Northwind Traders account in Salesforce, showing the same four cases that Claude listed."
						widths={[640, sfCases.width]}
						sizes="(min-width: 50rem) 38rem, 92vw"
						loading="eager"
					/>
				</div>
			</div>
			<figcaption>
				Ask in Claude, and it works in your Salesforce org as you: finding, reading, creating and
				updating records. Add your own tools and it can do anything Apex can.
			</figcaption>
		</figure>

		<section class="block">
			<h2>Two ways to use it.</h2>
			<p class="block-lede">
				Want Claude or ChatGPT to work with Salesforce? Set up the MCP server. Want a chat assistant
				inside Salesforce? Set up the agent. They draw on the same set of tools, and you can use either one
				without the other.
			</p>
			<div class="parts">
				{
					parts.map((part) => (
						<div class="part">
							<h3>
								<span class="part-icon" set:html={part.icon} />
								{part.name}
							</h3>
							<p>{part.what}</p>
							<dl>
								{part.facts.map(([term, detail]) => (
									<div>
										<dt>{term}</dt>
										<dd>{detail}</dd>
									</div>
								))}
							</dl>
							<a class="text-link" href={part.link.href}>
								{part.link.text}
							</a>
						</div>
					))
				}
			</div>
		</section>

		<section class="block">
			<h2>Why ApexAgent.</h2>
			<div class="why" style="--why-rows: 6">
				{
					why.map((col) => (
						<div class="why-col">
							<h3>
								<span class="part-icon" set:html={col.icon === 'mcp' ? mcpIcon : agentIcon} />
								{col.name}
							</h3>
							<dl>
								{col.points.map(([term, detail]) => (
									<div>
										<dt>{term}</dt>
										<dd>{detail}</dd>
									</div>
								))}
							</dl>
							<div class="cost">
								<p class="cost-title">{col.cost.title}</p>
								{col.cost.bars.map((bar) => (
									<div class="cost-row">
										<span class="cost-label">{bar.label}</span>
										<span class="cost-track">
											<span
												class:list={['cost-bar', { 'cost-bar-unknown': bar.unknown, 'cost-bar-ours': bar.label === 'ApexAgent' }]}
												style={`width: ${bar.width}%`}
											/>
										</span>
										<span class="cost-value">{bar.value}</span>
									</div>
								))}
								<p class="cost-note">{col.cost.note}</p>
							</div>
							<a class="text-link" href={col.link.href}>
								{col.link.text}
							</a>
						</div>
					))
				}
				<figure class="parts-shot">
					<Image
						src={lumenCases}
						alt="Lumen, the starter agent, in the Salesforce utility bar, answering the same question with a list of four open cases."
						widths={[440, lumenCases.width]}
						sizes="(min-width: 72rem) 22rem, (min-width: 50rem) 24rem, 92vw"
					/>
					<figcaption>Lumen answers the same question inside Salesforce.</figcaption>
				</figure>
			</div>
		</section>

		<section class="block split">
			<div>
				<h2>Set it up in three steps.</h2>
				<p class="block-lede">
					About 15 minutes. The install guide covers what you need first and walks through each step.
				</p>
				<p class="block-lede">
					Works in Developer, Enterprise, Performance and Unlimited Edition orgs.
				</p>
				<div class="actions">
					<a class="btn btn-solid" href={docs('start/install')}>Start the install guide</a>
				</div>
			</div>
			<ol class="steps">
				{
					steps.map(([name, detail]) => (
						<li>
							<h3>{name}</h3>
							<p>{detail}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="block">
			<h2>Your data, your rules.</h2>
			<p class="block-lede">
				An AI model only ever sees what answers the question, and only data that user may see. It
				goes to the provider you choose, under the agreement you already have with them.
			</p>
			<dl class="rows">
				{
					security.map(([term, detail]) => (
						<div>
							<dt>{term}</dt>
							<dd>{detail}</dd>
						</div>
					))
				}
			</dl>
			<a class="text-link" href={docs('operate/security')}>Read how your data is protected</a>
		</section>

		<section class="block">
			<h2>Configured with records, not code.</h2>
			<p class="block-lede">
				Each of these is a record in ApexAgent's Setup Portal app. Change what an agent is told
				and it applies from the next message, with nothing to deploy.
			</p>
			<dl class="rows">
				{
					config.map(([term, detail]) => (
						<div>
							<dt>{term}</dt>
							<dd>{detail}</dd>
						</div>
					))
				}
			</dl>
			<p class="after">
				<a class="text-link" href={docs('tools/built-in')}>See the ten tools</a>
				<a class="text-link" href={docs('tools/add-a-tool')}>Add your own tool</a>
				<a class="text-link" href={docs('agent/customise')}>Customise an agent</a>
			</p>
		</section>

		<section class="block">
			<h2>Open source, MIT licensed.</h2>
			<p class="block-lede">
				All of ApexAgent is on GitHub. Read the code before you deploy it, change it to fit your
				org, and send back what you fix.
			</p>
			<div class="actions">
				<a class="btn btn-solid" href={repo}><svg class="gh" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.200 1.900 1.200 1 1.800 2.800 1.300 3.500 1 0-.8.4-1.300.7-1.600-2.700-.3-5.500-1.300-5.500-6 0-1.200.5-2.300 1.300-3.100-.200-.400-.600-1.600 0-3.200 0 0 1-.300 3.400 1.200a11.500 11.500 0 0 1 6 0c2.300-1.500 3.300-1.200 3.300-1.200.700 1.600.200 2.800.100 3.200.800.800 1.300 1.900 1.300 3.100 0 4.700-2.800 5.700-5.500 6 .500.400.900 1.100.900 2.200v3.300c0 .300.100.700.800.600A12 12 0 0 0 12 .3"/></svg>View on GitHub</a>
				<a class="btn btn-line" href={`${repo}/issues`}>Report an issue</a>
				<a class="gh-link" href={docs('project/contributing')}>How to contribute</a>
			</div>
		</section>

		<footer class="foot">
			<p>
				ApexAgent is open source under the <a href={`${repo}/blob/main/LICENSE`}>MIT license</a>.
			</p>
			<p>
				Not affiliated with or endorsed by Salesforce. Salesforce and Agentforce are trademarks of
				Salesforce, Inc.
			</p>
			<div class="foot-theme">
				<ThemeSelect />
			</div>
		</footer>
	</div>
</StarlightPage>

<style is:global>
	/* Starlight's title is left out on this page, so its emptied panel and the rule under it go too. */
	:root:has(.aa) main > .content-panel:first-child {
		display: none;
	}

	:root:has(.aa) main > .content-panel {
		border-top: 0;
	}

	/* Search is for the docs pages; the landing page has nothing to search. */
	:root:has(.aa) site-search {
		display: none;
	}

	/* The header shares the content's left and right edges, and keeps its links at every width. */
	:root:has(.aa) header.header {
		padding-inline: max(1rem, calc((100% - 67.5rem) / 2));
	}

	:root:has(.aa) header.header .right-group {
		display: flex;
	}

	/* On a phone the theme switch moves to the footer, which leaves room for the name and the links. */
	@media (max-width: 30rem) {
		:root:has(.aa) header.header starlight-theme-select {
			display: none;
		}

		:root:has(.aa) header.header .social-icons::after {
			content: none;
		}
	}
</style>

<style>
	.aa {
		--ink: var(--sl-color-white);
		--paper: var(--sl-color-black);
		--muted: var(--sl-color-gray-3);
		--rule: var(--sl-color-gray-5);
		--surface: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: 1.0625rem;
		line-height: 1.55;
	}

	.aa h1,
	.aa h2,
	.aa h3 {
		color: var(--ink);
		margin: 0;
	}

	.aa p {
		margin: 0;
	}

	/* Hero: the headline is the image. */
	.hero {
		padding-block: 2.5rem 4rem;
	}

	.hero h1 {
		font-size: clamp(2.1rem, 7.6vw, 4.25rem);
		line-height: 1.05;
		letter-spacing: -0.028em;
	}

	.hero h1 > span {
		display: block;
		max-width: 17em;
	}

	/* The cost line is the second statement, so it steps back to grey as it does on the banner. */
	.hero-cost {
		margin-top: 0.3em;
		color: var(--muted);
	}

	.hero-cost span {
		display: block;
	}

	.hero .lede {
		max-width: 38rem;
		text-wrap: pretty;
		margin-top: 1.75rem;
		font-size: 1.1875rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	/* Buttons take the mark's corner cut: one sliced corner at the bars' slant. */
	.btn {
		--cut: 0.9rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0 1.5rem 0 1.25rem;
		font-weight: 600;
		text-decoration: none;
		clip-path: polygon(
			0 0,
			calc(100% - var(--cut) * var(--aa-slant)) 0,
			100% var(--cut),
			100% 100%,
			0 100%
		);
	}

	.btn-solid {
		background: var(--ink);
		color: var(--paper);
	}

	.btn-solid:hover {
		background: var(--sl-color-gray-2);
	}

	.btn-line {
		background: var(--surface);
		color: var(--ink);
	}

	.btn-line:hover {
		background: var(--rule);
	}

	.btn:focus-visible {
		clip-path: none;
	}

	.gh {
		width: 1.125rem;
		height: 1.125rem;
		margin-inline-end: 0.5rem;
		fill: currentColor;
		flex: none;
	}

	/* The third action is a plain link, so the two buttons keep the lead. */
	.gh-link {
		display: inline-flex;
		align-items: center;
		min-height: 3rem;
		padding-inline: 0.5rem;
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}

	.gh-link:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	/*
	 * The hero: two real windows, Claude and Salesforce, with the ApexAgent mark on the
	 * line that joins them. The figure keeps to the text column, so its edges line up
	 * with the headline on the left and the header's controls on the right.
	 */
	.hero-shot {
		margin: -1rem 0 3.5rem;
	}

	.hero-stage {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		padding-block: 2.5rem;
	}

	/*
	 * Behind the windows: fine lines at the slant of the mark's bars, fading out towards
	 * the edges, so the windows have something to stand in front of.
	 */
	.hero-stage::before {
		content: '';
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			117.5deg,
			transparent 0 13px,
			color-mix(in srgb, var(--ink) 16%, transparent) 13px 14px
		);
		mask-image: radial-gradient(ellipse 62% 70% at 50% 50%, #000 35%, transparent 100%);
		pointer-events: none;
	}

	.hero-win {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.75rem;
		background: var(--surface);
		z-index: 1;
	}

	/*
	 * On black a dark shadow cannot show, so the lift comes from one soft light behind
	 * both windows. It is a single shape, so the two windows are lit evenly.
	 */
	.hero-stage::after {
		content: '';
		position: absolute;
		inset: 1.25rem 0 0.5rem;
		border-radius: 3rem;
		background: rgb(255 255 255 / 0.13);
		filter: blur(3rem);
		pointer-events: none;
	}

	:global([data-theme='light']) .hero-stage::after {
		content: none;
	}

	:global([data-theme='light']) .hero-win {
		border-color: var(--sl-color-gray-5);
		box-shadow: 0 2.25rem 4.5rem -2rem rgb(0 0 0 / 0.35);
	}

	.hero-win-bar {
		padding: 0.625rem 0.875rem;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
	}

