<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>ApexAgent_Message_Log__c.Input_Tokens__c:SUM + ApexAgent_Message_Log__c.Output_Tokens__c:SUM</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Total Tokens</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(ApexAgent_Message_Log__c.Input_Tokens__c:SUM = 0, 0, ApexAgent_Message_Log__c.Cached_Input_Tokens__c:SUM / ApexAgent_Message_Log__c.Input_Tokens__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Cache Hit Rate</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(RowCount = 0, 0, ApexAgent_Message_Log__c.Cost__c:SUM / RowCount)</calculatedFormula>
        <datatype>currency</datatype>
        <developerName>FORMULA3</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Avg Cost per Message</masterLabel>
        <scale>4</scale>
    </aggregates>
    <columns>
        <field>ApexAgent_Message_Log__c$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Unique</aggregateTypes>
        <field>ApexAgent_Message_Log__c$Thread__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>ApexAgent_Message_Log__c$Cost__c</field>
    </columns>
    <columns>
        <aggregateTypes>Average</aggregateTypes>
        <aggregateTypes>Maximum</aggregateTypes>
        <field>ApexAgent_Message_Log__c$Duration_ms__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>ApexAgent_Message_Log__c$Input_Tokens__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>ApexAgent_Message_Log__c$Cached_Input_Tokens__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>ApexAgent_Message_Log__c$Output_Tokens__c</field>
    </columns>
    <description>Messages, threads, cost, tokens and response time per day and agent. Feeds the Agent dashboard KPIs and trend.</description>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>ApexAgent_Message_Log__c$Started_At__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <aggregateType>RowCount</aggregateType>
        <dateGranularity>Day</dateGranularity>
        <field>ApexAgent_Message_Log__c$Agent__c</field>
        <sortByName>RowCount</sortByName>
        <sortOrder>Desc</sortOrder>
        <sortType>Aggregate</sortType>
    </groupingsDown>
    <name>Agent Activity by Day</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>ApexAgent_Message_Logs__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>ApexAgent_Message_Log__c$Started_At__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
